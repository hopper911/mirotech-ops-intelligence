# Auth.js / NextAuth — required in production
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: public app URL (useful behind proxies)
# AUTH_URL=http://localhost:3000

# Optional: override admin Data Studio credentials (defaults in brand.ts)
# ADMIN_EMAIL=admin@mirotech.io
# ADMIN_PASSWORD=12345mirotech

# Object storage — Cloudflare R2 (preferred when set)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mirotech-media
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Fallback when R2 is not configured (auto-linked via `vercel blob create-store`)
# BLOB_READ_WRITE_TOKEN=
